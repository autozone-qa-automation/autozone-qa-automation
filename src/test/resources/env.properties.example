# ==========================================
# Autozone-QA - Integration test environment
# ==========================================
#
# Copy this file to "env.properties" (same folder) and fill in the values
# for your local environment. "env.properties" is git-ignored.
#
# Resolution order for every setting below (first match wins):
#   1. JVM system property (-Dapi.base.url=...)
#   2. Environment variable (API_BASE_URL)
#   3. This file (env.properties)
#   4. Built-in default (only api.base.url / api.login.path have one)

# Base URL of the backend API (no trailing slash). Defaults to
# http://localhost:8080 for local development if not set anywhere.
api.base.url=http://localhost:8080

# Login endpoint path. Defaults to /api/v1/authentify if not set anywhere.
api.login.path=/api/v1/authentify

# ADMIN account used by the integration suite to obtain a Bearer token.
# This user MUST exist in the database with a BCrypt-hashed password -
# see db/seed_admin.sql and the README "Integration tests" section for
# how to seed it. These two values must match the seeded credentials.
api.username=admin@autozone.com
api.password=Qa!Admin2026
